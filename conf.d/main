#!/bin/bash -ex

DB_NAME=ninja
DB_USER=ninja
DB_PASS=$(mcookie)

ADMIN_MAIL="noreply%40turnkeylinux.org" # '@' encoded = '%40'
ADMIN_PASS=turnkey1
ADMIN_FNAME="TurnKey"
ADMIN_LNAME="Linux"

SRC=/usr/local/src
WEBROOT=/var/www/invoiceninja
CONF=$WEBROOT/.env
VERSION=v5.13.36

LOC_SHARE=/usr/local/share
LOC_BIN=/usr/local/bin

# install Invoice Ninja
mkdir -p $WEBROOT
tar -xzf "$SRC/invoiceninja-$VERSION.tar.gz" -C "$WEBROOT"
rm -f "$SRC/invoiceninja-$VERSION.tar.gz"

service mysql start

mysqladmin create $DB_NAME
mysql --batch --execute "grant all privileges on $DB_NAME.* to $DB_USER@localhost identified by '$DB_PASS'; flush privileges;"

a2dissite 000-default
a2ensite invoiceninja
a2enmod rewrite

service apache2 start

cp $WEBROOT/.env.example $CONF
sed -i "\|APP_NAME=|s|=.*|='TurnKey Invoice Ninja'|" $CONF
sed -i "\|API_SECRET=|s|=.*|=$(mcookie)$(mcookie)|" $CONF
sed -i "s/^DB_DATABASE=.*/DB_DATABASE=$DB_NAME/g" $CONF
sed -i "s/^DB_USERNAME=.*/DB_USERNAME=$DB_USER/g" $CONF
sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=$DB_PASS/g" $CONF

sed -i "s/^QUEUE_CONNECTION=.*/QUEUE_CONNECTION=database/g" $CONF
sed -i "/^QUEUE_CONNECTION/ a INTERNAL_QUEUE_ENABLED=false" $CONF

install -d -o www-data -g www-data -m 0750 /var/log/invoiceninja

# Keep executable application code outside the web-service write boundary.
# Laravel's installer must update .env during setup; relock it immediately
# after setup has finished below.
chown -R root:root "$WEBROOT"
find "$WEBROOT" -type d -exec chmod 0755 {} +
find "$WEBROOT" -type f -exec chmod 0644 {} +
chown -R www-data:www-data "$WEBROOT/storage" "$WEBROOT/bootstrap/cache"
chown www-data:www-data "$CONF"
chmod 0640 "$CONF"

# Install the separately pinned Snappdf Chromium payload and make it the
# default PDF generator without invoking Snappdf's moving downloader.
chmod +x "$WEBROOT/vendor/bin/snappdf"
install -d -o root -g root -m 0755 \
    "$WEBROOT/vendor/beganovich/snappdf/versions/ungoogled"
tar --no-same-owner -xf "$SRC/snappdf-ungoogled.tar" \
    -C "$WEBROOT/vendor/beganovich/snappdf/versions/ungoogled"
rm -f "$SRC/snappdf-ungoogled.tar"
# Snappdf uses this value verbatim as a directory name; a trailing newline
# makes its Chromium executable lookup point at a nonexistent path.
printf '%s' ungoogled \
    > "$WEBROOT/vendor/beganovich/snappdf/versions/revision.txt"
chmod 0755 \
    "$WEBROOT/vendor/beganovich/snappdf/versions/ungoogled/chrome-linux/chrome" \
    "$WEBROOT/vendor/beganovich/snappdf/versions/ungoogled/chrome-linux/chrome_crashpad_handler"
sed -i "\|^PDF_GENERATOR|s|=.*|=snappdf|" $CONF

# set up turnkey-artisan
sed -i "\|^export WEBROOT=|s|=.*|=${WEBROOT}|" /usr/local/bin/turnkey-artisan

turnkey-artisan key:generate --force
turnkey-artisan config:clear
turnkey-artisan migrate --force
turnkey-artisan optimize

sleep 10
COOKIE=/run/invoice-ninja-setup.cookie
CURL=(curl -c "$COOKIE" -b "$COOKIE")
TOKEN=$("${CURL[@]}" http://localhost/setup 2>/dev/null | grep csrf-token | sed 's|^.*content="\([a-zA-Z0-9]*\)".*$|\1|')
sleep 10
"${CURL[@]}" 'http://localhost/setup' -X POST --data-raw "\
_token=$TOKEN\
&url=https%3A%2F%2Fexample.com\
&https=on\
&db_driver=MySQL\
&db_host=localhost\
&db_port=3306\
&db_database=$DB_NAME\
&db_username=$DB_USER\
&db_password=$DB_PASS\
&mail_driver=log\
&mail_name=&mail_address=&mail_username=&mail_host=&mail_port=\
&encryption=tls\
&mail_password=\
&first_name=$ADMIN_FNAME\
&last_name=$ADMIN_LNAME\
&email=$ADMIN_MAIL\
&password=$ADMIN_PASS\
&terms_of_service=on\
&privacy_policy=on"
rm -f "$COOKIE"

cat > /etc/cron.d/invoice-ninja  <<EOF
# TurnKey Invoice Ninja cron job
# runs turnkey-artisan as root (which runs 'php artisan' as www-data)
  * * * * * root cd /var/www/invoiceninja && /usr/local/bin/turnkey-artisan schedule:run >> /dev/null 2>&1
EOF

# configure email via system postfix - needs to be done post-install to ensure it's not overwritten
sed -i "s/^MAIL_MAILER=.*/MAIL_MAILER=sendmail/g" $CONF
sed -i "s/^MAIL_HOST=.*/MAIL_HOST=localhost/g" $CONF
sed -i "s/^MAIL_PORT=.*/MAIL_PORT=25/g" $CONF
sed -i "s/^MAIL_ENCRYPTION=.*/MAIL_ENCRYPTION=\"\"/g" $CONF
sed -i "s/^MAIL_FROM_ADDRESS=.*/MAIL_FROM_ADDRESS='admin@example.com'/g" $CONF
sed -i "s/^MAIL_FROM_NAME=.*/MAIL_FROM_NAME='TurnKey Invoice Ninja'/g" $CONF

# Add API_SECRET to .env so it's ready to go - inithook will offer to set it (if left blank it's ignored)
sed -i "/^APP_URL/a API_SECRET=" $CONF

# Setup is complete: configuration is readable by the web service but only
# writable by root in the shipped appliance.
chown root:www-data "$CONF"
chmod 0640 "$CONF"

# test PDF generation
cd $WEBROOT
runuser -u www-data -- ./vendor/bin/snappdf convert \
    --html "<h1>Hello world!</h1>" storage/test.pdf
rm -f storage/test.pdf

service mysql stop
service apache2 stop
